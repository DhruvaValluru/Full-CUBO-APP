      "name": "Start Drive",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Enabled route-preview action; runtime availability depends on live route and drive state.",
      "html": "<button class=\"ds-start ds-control\">Start drive</button>",
      "css": ".ds-start{min-height:48px;width:100%;border:0;border-radius:14px;background:#087D52;color:#fff;font:800 12px Manrope,system-ui,sans-serif}.ds-control:hover:not(:disabled){opacity:.96}.ds-control:focus-visible{outline:2px solid #087D52;outline-offset:3px}.ds-control:active:not(:disabled){opacity:.92;transform:scale(.97)}.ds-control:disabled{opacity:.35}.ds-control{transition:opacity 100ms ease-out,transform 100ms ease-out}@media(prefers-reduced-motion:reduce){.ds-control:active:not(:disabled){transform:none}}"
    },

    {
      "name": "Floating Navigation",
      "kind": "nav",
      "refersTo": "navigation-floating",
      "description": "Five destinations with transparent item backgrounds; active drives hide the bar. Inline SVGs are static panel translations.",
      "html": "<nav class=\"ds-nav\" role=\"tablist\"><button class=\"ds-nav-item ds-control\" role=\"tab\" aria-selected=\"true\"><svg aria-hidden=\"true\" width=\"23\" height=\"23\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M3 11l9-8 9 8v10h-6v-7H9v7H3z\"/></svg><span>Home</span></button><button class=\"ds-nav-item ds-control\" role=\"tab\" aria-selected=\"false\"><svg aria-hidden=\"true\" width=\"23\" height=\"23\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M3 5l6-2 6 2 6-2v16l-6 2-6-2-6 2zM9 3v16M15 5v16\"/></svg><span>Map</span></button><button class=\"ds-nav-item ds-control\" role=\"tab\" aria-selected=\"false\"><svg aria-hidden=\"true\" width=\"23\" height=\"23\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M6 3h12v18l-3-2-3 2-3-2-3 2zM9 8h6M9 12h6\"/></svg><span>Activity</span></button><button class=\"ds-nav-item ds-control\" role=\"tab\" aria-selected=\"false\"><svg aria-hidden=\"true\" width=\"23\" height=\"23\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M4 10l2-6h12l2 6v10h-3v-3H7v3H4zM4 10h16\"/></svg><span>Garage</span></button><button class=\"ds-nav-item ds-control\" role=\"tab\" aria-selected=\"false\"><svg aria-hidden=\"true\" width=\"23\" height=\"23\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M16 6a4 4 0 1 1-8 0 4 4 0 0 1 8 0M4 22v-3a8 8 0 0 1 16 0v3z\"/></svg><span>Account</span></button></nav>",
      "css": ".ds-nav{display:flex;min-height:72px;padding:6px 7px;border:1px solid rgba(13,76,49,.19);border-radius:26px;background:#fff;box-shadow:0 10px 24px rgba(20,35,29,.028)}.ds-nav-item{flex:1;min-width:0;min-height:54px;display:flex;flex-direction:column;gap:2px;align-items:center;justify-content:center;border:0;border-radius:17px;background:transparent;color:#53635A;font:600 10px Manrope,system-ui,sans-serif}.ds-nav-item[aria-selected=true]{color:#087D52;font-weight:800}.ds-nav-item[aria-selected=true] svg{fill:currentColor}.ds-control:hover:not(:disabled){opacity:.96}.ds-control:focus-visible{outline:2px solid #087D52;outline-offset:3px}.ds-control:active:not(:disabled){opacity:.92;transform:scale(.97)}.ds-control:disabled{opacity:.35}.ds-control{transition:opacity 100ms ease-out,transform 100ms ease-out}@media(prefers-reduced-motion:reduce){.ds-control:active:not(:disabled){transform:none}}"
    },
    {
      "name": "Safety Field",
      "kind": "custom",
      "refersTo": "safety-field",
      "description": "Illustrative starter score using the implemented ring geometry. Runtime content uses real account and drive state.",
      "html": "<section class=\"ds-safety\"><header><span>Good evening,</span><strong>Welcome</strong></header><button aria-label=\"Starter safety score 100. Open Drive Activity\" class=\"ds-ring ds-control\"><svg aria-hidden=\"true\" width=\"252\" height=\"252\" viewBox=\"0 0 252 252\"><defs><linearGradient id=\"ds-ring-gradient\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#AEFF8B\"/><stop offset=\".55\" stop-color=\"#53DD63\"/><stop offset=\"1\" stop-color=\"#168441\"/></linearGradient></defs><circle cx=\"126\" cy=\"126\" r=\"123\" stroke=\"#83D978\" stroke-opacity=\".12\" fill=\"none\"/><circle cx=\"126\" cy=\"126\" r=\"105\" stroke=\"#A5FF7A\" stroke-opacity=\".08\" stroke-width=\"22\" fill=\"none\"/><circle cx=\"126\" cy=\"126\" r=\"105\" stroke=\"#8BAF82\" stroke-opacity=\".22\" stroke-width=\"8\" fill=\"none\"/><circle cx=\"126\" cy=\"126\" r=\"105\" stroke=\"url(#ds-ring-gradient)\" stroke-width=\"11\" fill=\"none\"/></svg><strong>100</strong><span>Starter safety score</span><svg class=\"ds-shield\" aria-hidden=\"true\" width=\"25\" height=\"25\" viewBox=\"0 0 24 24\" fill=\"#9AE784\"><path d=\"M12 2l9 4v6c0 5-6 9-9 10-3-1-9-5-9-10V6z\"/><path d=\"m7 12 3 3 7-7\" fill=\"none\" stroke=\"#0B3023\" stroke-width=\"2\"/></svg></button><p>Ready for your next drive</p></section>",
      "css": ".ds-safety{min-height:422px;padding:22px 24px 54px;background:radial-gradient(ellipse at 50% 52%,rgba(72,170,75,.38),transparent 70%),linear-gradient(#0B3023,#0E4A2D,#072B1C);color:#fff;font-family:Manrope,system-ui,sans-serif;display:flex;flex-direction:column;align-items:center}.ds-safety header{align-self:stretch;margin-bottom:8px}.ds-safety header span{display:block;font-size:17px;color:#D3E4D8}.ds-safety header strong{font-size:29px;line-height:36px;letter-spacing:-.7px;font-weight:800}.ds-ring{position:relative;width:252px;height:252px;padding:8px 0 0;border:0;background:transparent;display:flex;flex-direction:column;align-items:center;justify-content:center;color:inherit;font-family:inherit}.ds-ring>svg:first-child{position:absolute;inset:0}.ds-ring strong{font-size:68px;line-height:78px;font-weight:800;letter-spacing:-3px;font-variant-numeric:tabular-nums}.ds-ring span{font-size:13px;font-weight:500;color:#D4E9D6;margin-top:4px}.ds-shield{margin-top:14px}.ds-safety p{font-size:22px;font-weight:700;letter-spacing:-.6px;text-align:center;margin:12px 0 0}.ds-control:hover:not(:disabled){opacity:.96}.ds-control:focus-visible{outline:2px solid #087D52;outline-offset:3px}.ds-control:active:not(:disabled){opacity:.92;transform:scale(.97)}.ds-control:disabled{opacity:.35}.ds-control{transition:opacity 100ms ease-out,transform 100ms ease-out}@media(prefers-reduced-motion:reduce){.ds-control:active:not(:disabled){transform:none}}"
    },
    {
      "name": "Assistant Action",
      "kind": "button",
      "refersTo": "assistant-action",
      "description": "Quiet follow-on action below the Home destination control.",
      "html": "<button class=\"ds-assistant ds-control\"><svg aria-hidden=\"true\" width=\"23\" height=\"23\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"m12 2 2.5 7.5L22 12l-7.5 2.5L12 22l-2.5-7.5L2 12l7.5-2.5z\"/></svg><span><strong>Ask Cubo Assistant</strong><small>Your drive, your questions. Just ask.</small></span></button>",
      "css": ".ds-assistant{width:100%;min-height:76px;display:flex;gap:12px;align-items:center;text-align:left;border:0;border-radius:16px;padding:16px;background:rgba(8,125,82,.10);color:#102019}.ds-assistant>svg{color:#087D52;flex-shrink:0}.ds-assistant strong{font:700 16px Manrope,system-ui,sans-serif}.ds-assistant small{display:block;color:#53635A;margin-top:3px;font:11px/17px system-ui,sans-serif}.ds-control:hover:not(:disabled){opacity:.96}.ds-control:focus-visible{outline:2px solid #087D52;outline-offset:3px}.ds-control:active:not(:disabled){opacity:.92;transform:scale(.97)}.ds-control:disabled{opacity:.35}.ds-control{transition:opacity 100ms ease-out,transform 100ms ease-out}@media(prefers-reduced-motion:reduce){.ds-control:active:not(:disabled){transform:none}}"
    }
  ],
  "narrative": {
    "northStar": "The Calm Cockpit",
    "overview": "CUBO treats each screen like a composed vehicle cabin: the state a driver needs now is dominant, while supporting controls remain calm, predictable, and close to the hand. A broad forest field gives safety readiness its own space; the live map gives destination selection its own canvas. Strong hierarchy, real account data, and explicit actions define the experience.\n\nThe visual system pairs mineral light surfaces with green-black dark surfaces, a luminous score ring, and quiet typography. Photography is concentrated in the dusk welcome scene. Home and Account use forest headers in both appearances; the controls beneath them follow the selected theme. The approved compositions in `.impeccable/mocks/approved/` and `docs/mockup-fidelity-2026-10-22.md` govern these surfaces. The mockups' names, addresses, scores, and map contents are examples, not product data.",
    "keyCharacteristics": [
      "A full-width forest safety field with a luminous, data-driven score ring.",
      "Mineral light surfaces, forest dark surfaces, and clear semantic accents.",
      "A destination action across Home's boundary and one unified idle Map sheet.",
      "Five floating destinations: Home, Map, Activity, Garage, Account.",
      "Real photographic atmosphere with semantic text and actions.",
      "One-shot entrance motion and reduced-motion-aware press feedback."
    ],
    "rules": [
      {
        "name": "The Forest and Signal Rule",
        "body": "Forest may fill the dominant header; the bright ring is reserved for the score, and ordinary controls use the theme accent.",
        "section": "colors"
      },
      {
        "name": "The Glance Rule",
        "body": "The important number or action reads before supporting copy; labels remain subordinate to the primary state.",
        "section": "typography"
      },
      {
        "name": "The Float With Purpose Rule",
        "body": "A shadow signals a surface that overlays or controls the page; ordinary rows use tone and spacing.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preserve the approved full-width forest Home field, score ring, boundary-crossing destination action, and five-tab hierarchy.",
      "**Do** keep Map's idle search, places, route preview, and Start drive together in one scrollable sheet.",
      "**Do** use real account, permission, route, and drive state for all operational copy.",
      "**Do** maintain light and dark appearance, visible focus, and the product requirement of at least 44px touch targets.",
      "**Do** honor reduced motion and keep primary actions semantic and reachable."
    ],
    "donts": [
      "**Don't** flatten the approved compositions into palette-only changes or equal-weight cards.",
      "**Don't** turn the score ring's luminous treatment into a universal neon accent.",
      "**Don't** bake text or controls into the welcome photograph or seed mockup identities and addresses.",
      "**Don't** equate saved calibration with active camera access or configured app blocking with enforced blocking.",
      "**Don't** imply safety guarantees, traffic knowledge, or backend abilities the live product does not supply."
    ]
  }
}

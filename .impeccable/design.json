      "name": "Calibration Card",
      "kind": "card",
      "refersTo": "card-calibration",
      "description": "Supporting setup action. Saved calibration does not assert active camera access.",
      "html": "<button class=\"ds-calibration ds-control\"><span class=\"ds-calibration-icon\"><svg aria-hidden=\"true\" width=\"23\" height=\"23\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M4 6h4l2-2h4l2 2h4v14H4zM16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0\"/></svg></span><span><strong>Camera Calibration</strong><small>Set your driver and cabin frame</small></span></button>",
      "css": ".ds-calibration{min-height:76px;width:100%;display:flex;align-items:center;text-align:left;gap:12px;padding:14px;border:1px solid rgba(13,76,49,.19);border-radius:22px;background:#fff;color:#102019;box-shadow:0 6px 14px rgba(20,35,29,.0112)}.ds-calibration-icon{width:46px;height:46px;border-radius:16px;border:1px solid rgba(13,61,41,.10);background:rgba(8,125,82,.10);color:#087D52;display:grid;place-items:center;flex-shrink:0}.ds-calibration strong{font:800 14px Manrope,system-ui,sans-serif}.ds-calibration small{display:block;margin-top:3px;color:#53635A;font:11px/16px system-ui,sans-serif}.ds-control:hover:not(:disabled){opacity:.96}.ds-control:focus-visible{outline:2px solid #087D52;outline-offset:3px}.ds-control:active:not(:disabled){opacity:.92;transform:scale(.97)}.ds-control:disabled{opacity:.35}.ds-control{transition:opacity 100ms ease-out,transform 100ms ease-out}@media(prefers-reduced-motion:reduce){.ds-control:active:not(:disabled){transform:none}}"

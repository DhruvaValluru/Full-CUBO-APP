    {
      "name": "Destination Input",
      "kind": "input",
      "refersTo": "input-destination",
      "description": "Muted search row within the idle Map sheet. Sample focus treatment is a panel affordance; app focus is control-specific.",
      "html": "<label class=\"ds-search\"><svg aria-hidden=\"true\" width=\"23\" height=\"23\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M21 21l-5-5M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0\"/></svg><input aria-label=\"Destination\" placeholder=\"Where are you going?\"/><button class=\"ds-search-go ds-control\" aria-label=\"Search\"><svg aria-hidden=\"true\" width=\"23\" height=\"23\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></button></label>",
      "css": ".ds-search{display:flex;align-items:center;gap:8px;min-height:58px;padding:0 12px;border-radius:16px;background:#F0F3F0;color:#53635A}.ds-search>svg{flex-shrink:0}.ds-search input{flex:1;min-width:0;width:0;padding:8px 0;border:0;background:transparent;color:#102019;font:600 17px Manrope,system-ui,sans-serif}.ds-search input::placeholder{color:#5E6E65}.ds-search input:focus-visible{outline:2px solid #087D52;outline-offset:2px}.ds-search-go{flex-shrink:0;width:44px;height:44px;border:0;border-radius:22px;background:#087D52;color:white;display:grid;place-items:center}.ds-control:hover:not(:disabled){opacity:.96}.ds-control:focus-visible{outline:2px solid #087D52;outline-offset:3px}.ds-control:active:not(:disabled){opacity:.92;transform:scale(.97)}.ds-control:disabled{opacity:.35}.ds-control{transition:opacity 100ms ease-out,transform 100ms ease-out}@media(prefers-reduced-motion:reduce){.ds-control:active:not(:disabled){transform:none}}"
    },

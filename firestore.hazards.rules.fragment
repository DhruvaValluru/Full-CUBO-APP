// LEGACY REFERENCE ONLY: do not deploy this fragment.
// Superseded by firestore.hazards.proposed.rules and firebase.hazards.proposed.json,
// which enforce atomic unique confirmations, retirement, and expiry.
// Proposed addition inside match /databases/{database}/documents.
// roadReports: immutable reporterId (Auth UID), kind enum, geographic coordinates,
// cell (0.01-degree grid), createdAt (server timestamp). No name, email, or route.
// confirmations/{uid}: voterId, present boolean, updatedAt server timestamp.
function validRoadReport(data) {
  return data.keys().hasAll(['reporterId', 'kind', 'latitude', 'longitude', 'cell', 'createdAt'])
    && data.keys().hasOnly(['reporterId', 'kind', 'latitude', 'longitude', 'cell', 'createdAt'])
    && data.reporterId is string && data.reporterId.size() >= 1 && data.reporterId.size() <= 128
    && data.kind in ['object', 'police', 'crash']
    && data.latitude is number && data.latitude >= -90 && data.latitude <= 90
    && data.longitude is number && data.longitude >= -180 && data.longitude <= 180
    && data.cell is string && data.cell.size() <= 24
    && data.cell == string(math.floor(data.latitude * 100)) + ':' + string(math.floor(data.longitude * 100))
    && data.createdAt is timestamp;
}
function validRoadConfirmation(data) {
  return data.keys().hasAll(['voterId', 'present', 'updatedAt'])
    && data.keys().hasOnly(['voterId', 'present', 'updatedAt'])
    && data.voterId is string && data.voterId.size() >= 1 && data.voterId.size() <= 128
    && data.present is bool && data.updatedAt is timestamp;
}
match /roadReports/{reportId} {
  allow read: if request.auth != null;
  allow create: if request.auth != null && validRoadReport(request.resource.data)
    && request.resource.data.reporterId == request.auth.uid
    && request.resource.data.createdAt == request.time;
  allow update, delete: if false;
  match /confirmations/{voterId} {
    allow read: if request.auth != null;
    allow create, update: if request.auth != null && voterId == request.auth.uid
      && exists(/databases/$(database)/documents/roadReports/$(reportId))
      && get(/databases/$(database)/documents/roadReports/$(reportId)).data.reporterId != request.auth.uid
      && validRoadConfirmation(request.resource.data)
      && request.resource.data.voterId == request.auth.uid
      && request.resource.data.updatedAt == request.time;
    allow delete: if false;
  }
}
